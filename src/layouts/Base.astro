---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { langOf, enPathOf, hasRw, href, RW_PUBLIC } from "../i18n";
import { t } from "../i18n/strings";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}
const { title, description, ogTitle } = Astro.props;
const lang = langOf(Astro.url);
const s = t(lang);
const full = title === "home" ? `${site.name} — ${s.base.homeTitleSuffix}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

// Kinyarwanda pages stay out of search results until they are approved
// (src/i18n/flags.mjs). Once public, each translated page points at its twin.
const enPath = enPathOf(Astro.url.pathname);
const noindex = lang === "rw" && !RW_PUBLIC;
const alternates =
  RW_PUBLIC && hasRw(enPath)
    ? [
        { hreflang: "en", href: new URL(enPath, site.url).href },
        { hreflang: "rw", href: new URL(href(enPath, "rw"), site.url).href },
        { hreflang: "x-default", href: new URL(enPath, site.url).href },
      ]
    : [];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: s.base.ld,
  inLanguage: lang,
  url: site.url,
  email: site.email,
  telephone: site.phones[0],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kigali",
    addressCountry: "RW",
  },
  areaServed: "Africa",
  slogan: site.tagline,
  // Lets search engines connect the site to its social profiles, once there are any.
  ...(site.socials.length ? { sameAs: site.socials.map((x) => x.url) } : {}),
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0E0C0B" />

    {/* Google Search Console ownership (URL-prefix property, HTML tag method) */}
    {site.googleVerification && (
      <meta name="google-site-verification" content={site.googleVerification} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle ?? full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "rw" ? "rw_RW" : "en_RW"} />
    <meta property="og:image" content={new URL("/og.png", site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", site.url).href} />

    <link
      rel="preload"
      href="/fonts/satoshi-900.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/satoshi-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("inkingi-theme");
          if (!t)
            t = matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>

  <body>
    <a href="#main" class="skip">{s.base.skip}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <div class="grain" aria-hidden="true"></div>

    <script>
      /* ------------------------------------------------------------
         Reveal engine — one observer for the whole document.
         Elements rise once, then release will-change.
      ------------------------------------------------------------ */
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("seen");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 }
        );
        document
          .querySelectorAll("[data-reveal], .lines")
          .forEach((el) => io.observe(el));
      } else {
        document
          .querySelectorAll("[data-reveal], .lines")
          .forEach((el) => el.classList.add("seen"));
      }

      /* ------------------------------------------------------------
         Scroll-linked custom properties, written once per frame.
         Sections opt in with [data-track]; children read --p (0→1).
      ------------------------------------------------------------ */
      const tracked = Array.from(
        document.querySelectorAll<HTMLElement>("[data-track]")
      );
      if (tracked.length && !reduce) {
        let pending = false;
        const measure = () => {
          const vh = window.innerHeight;
          for (const el of tracked) {
            const r = el.getBoundingClientRect();
            const span = r.height + vh;
            const p = Math.min(1, Math.max(0, (vh - r.top) / span));
            el.style.setProperty("--p", p.toFixed(4));
          }
          pending = false;
        };
        const onScroll = () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(measure);
        };
        measure();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
