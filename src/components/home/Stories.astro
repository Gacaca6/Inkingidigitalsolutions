---
import { stories } from "../../data/site";
import Arrow from "../Arrow.astro";
---

<section class="st">
  <div class="page">
    <div class="st-head">
      <div>
        <p class="tag" data-reveal><span class="idx">04</span> Client stories</p>
        <h2 class="d1" data-reveal style="--rd:60ms">
          Challenge. Solution.<br />What actually changed.
        </h2>
      </div>
      <a href="/work" class="tlink" data-reveal style="--rd:120ms">
        All stories
        <Arrow />
      </a>
    </div>

    <div class="list">
      {
        stories.map((s, i) => (
          <article class="story" data-reveal style={`--rd:${i * 60}ms`}>
            <header class="s-top">
              <div class="s-meta">
                <span class="s-idx num">{String(i + 1).padStart(2, "0")}</span>
                <span class="s-sec">{s.sector}</span>
                <span class="s-scale num">{s.scale}</span>
              </div>
              <h3 class="d3">{s.title}</h3>
            </header>

            <div class="s-body">
              <div class="beat">
                <p class="bk">Challenge</p>
                <p class="bt">{s.challenge}</p>
              </div>
              <div class="beat">
                <p class="bk">Solution</p>
                <p class="bt">{s.solution}</p>
              </div>
              <div class="beat">
                <p class="bk out">Outcome</p>
                <p class="bt">{s.outcome}</p>
              </div>
            </div>

            <div class="s-bottom">
              <dl class="mx">
                {s.metrics.map((m) => (
                  <div>
                    <dd class="num">{m.value}</dd>
                    <dt>{m.label}</dt>
                  </div>
                ))}
              </dl>
              <figure class="qt">
                <blockquote>“{s.quote}”</blockquote>
                <figcaption>{s.attribution}</figcaption>
              </figure>
            </div>
          </article>
        ))
      }
    </div>

    <p class="note xs">
      Clients are identified by sector at their request. Figures are taken from
      their own systems, measured before the engagement and twelve months after.
    </p>
  </div>
</section>

<style>
  .st {
    padding-block: var(--band-vast);
  }

  .st-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
  }
  .st-head h2 {
    margin-block-start: var(--s-4);
  }

  .list {
    display: grid;
    gap: var(--s-9);
    margin-block-start: var(--s-9);
  }

  .story {
    display: grid;
    gap: var(--s-6);
    padding-block-start: var(--s-6);
    border-block-start: 1px solid var(--hair);
  }

  .s-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .s-idx {
    color: var(--emerald-2);
  }
  .s-sec {
    color: var(--ink);
  }
  .s-scale {
    color: var(--ink-4);
    letter-spacing: 0.1em;
  }
  .s-top h3 {
    margin-block-start: var(--s-4);
    max-inline-size: 26ch;
  }

  /* three beats, read left to right */
  .s-body {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }
  .beat {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .bk {
    position: relative;
    padding-block-start: 0.85rem;
    border-block-start: 1px solid var(--hair);
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink-4);
  }
  .bk::before {
    content: "";
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    inline-size: 28px;
    block-size: 2px;
    background: var(--hair-2);
  }
  .bk.out {
    color: var(--emerald-2);
  }
  .bk.out::before {
    background: var(--emerald);
    inline-size: 44px;
  }
  .bt {
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1.62;
  }

  .s-bottom {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--s-7);
    align-items: end;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--hair);
  }
  .mx {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
  }
  .mx dd {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -0.042em;
    line-height: 1;
    margin: 0;
  }
  .mx dt {
    margin-block-start: 0.5rem;
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.4;
    max-inline-size: 18ch;
  }

  .qt blockquote {
    font-size: var(--t-d3);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: var(--tr-tight);
    text-wrap: balance;
  }
  .qt figcaption {
    margin-block-start: var(--s-4);
    font-size: var(--t-xs);
    color: var(--ink-4);
  }

  .note {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
    color: var(--ink-4);
    max-inline-size: 74ch;
  }

  @media (max-width: 940px) {
    .s-body {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .s-bottom {
      grid-template-columns: 1fr;
      gap: var(--s-6);
      align-items: start;
    }
  }
  @media (max-width: 560px) {
    .mx {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .mx > div {
      display: flex;
      align-items: baseline;
      gap: var(--s-4);
      justify-content: space-between;
    }
    .mx dt {
      margin-block-start: 0;
      text-align: end;
    }
  }
</style>
