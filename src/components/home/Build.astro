---
import { services } from "../../data/site";
import DemoSite from "../visuals/DemoSite.astro";
import DemoCloud from "../visuals/DemoCloud.astro";
import DemoBrand from "../visuals/DemoBrand.astro";
import DemoMarketing from "../visuals/DemoMarketing.astro";
import Arrow from "../Arrow.astro";

const demos = {
  site: DemoSite,
  cloud: DemoCloud,
  brand: DemoBrand,
  marketing: DemoMarketing,
};
---

<section id="services" class="build">
  <div class="page opener">
    <p class="tag" data-reveal><span class="idx">02</span> What we do</p>
    <div class="opener-grid">
      <h2 class="d1" data-reveal style="--rd:60ms">
        Four services. Shown, not listed.
      </h2>
      <p class="body" data-reveal style="--rd:140ms">
        Everything a Rwandan business needs to be found, trusted, and chosen
        online — designed, built, and looked after under one roof. Each one
        below is running live on this page.
      </p>
    </div>
  </div>

  {
    services.map((s, i) => {
      const Demo = demos[s.demo];
      const dark = i % 2 === 1;
      const flip = i % 2 === 1;
      return (
        <article id={s.slug} class:list={["cap", { "on-navy": dark, flip }]}>
          <div class="page cap-in">
            <div class="cap-say">
              <p class="tag" data-reveal>
                <span class="idx">{s.idx}</span> {s.name}
              </p>
              <h3 class="d2" data-reveal style="--rd:60ms">
                {s.tagline}
              </h3>
              <p class="body" data-reveal style="--rd:120ms">
                {s.summary}
              </p>
              <ul class="pts" data-reveal style="--rd:180ms">
                {s.includes.slice(0, 4).map((p) => (
                  <li>
                    <span class="di" />
                    {p}
                  </li>
                ))}
              </ul>
              <div class="cap-foot" data-reveal style="--rd:240ms">
                <a href={`/services/${s.slug}`} class="tlink">
                  {s.name} & pricing
                  <Arrow />
                </a>
              </div>
            </div>

            <div class="cap-demo" data-reveal="scale" style="--rd:140ms">
              <Demo />
            </div>
          </div>
        </article>
      );
    })
  }
</section>

<style>
  .opener {
    padding-block: var(--band) var(--s-8);
  }
  .opener-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--s-7);
    align-items: end;
    margin-block-start: var(--s-4);
  }
  .opener-grid h2 {
    max-inline-size: 14ch;
  }

  .cap {
    padding-block: var(--band-tight);
  }
  .cap.on-navy {
    padding-block: var(--band);
  }

  .cap-in {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .cap.flip .cap-say {
    order: 2;
  }

  .cap-say {
    display: grid;
    gap: var(--s-4);
    align-content: center;
    justify-items: start;
  }
  .cap-say h3 {
    max-inline-size: 16ch;
  }
  .cap-say .body {
    max-inline-size: 48ch;
  }

  .pts {
    display: grid;
    gap: 0.6rem;
    margin-block-start: var(--s-2);
  }
  .pts li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
  }
  .di {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 1.5px;
    rotate: 45deg;
    background: var(--emerald);
    flex: none;
    translate: 0 -1px;
  }

  .cap-foot {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
    inline-size: 100%;
  }

  .cap-demo {
    min-inline-size: 0;
  }

  @media (max-width: 940px) {
    .opener-grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      align-items: start;
    }
    .cap-in {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .cap.flip .cap-say {
      order: 0;
    }
  }
</style>
