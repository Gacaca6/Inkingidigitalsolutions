---
import { principles, stack } from "../../data/site";
---

<section class="pr on-navy">
  <div class="page">
    <div class="pr-grid">
      <!-- left: the five commitments, as a ledger -->
      <div class="left">
        <p class="tag" data-reveal><span class="idx">05</span> What we hold to</p>
        <h2 class="d2" data-reveal style="--rd:60ms">
          Five constraints every<br />decision is checked against.
        </h2>

        <ul class="ps">
          {
            principles.map((p, i) => (
              <li data-reveal style={`--rd:${80 + i * 60}ms`}>
                <span class="pn num">{p.n}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- right: the toolkit, as a technical index -->
      <aside class="right" data-reveal style="--rd:160ms">
        <p class="tag">Toolkit</p>
        <p class="rl">
          Boring where boring is correct. New only where it earns its place.
        </p>
        <ul class="stk">
          {
            stack.map((s, i) => (
              <li style={`--i:${i}`}>
                <span class="sn">{s.name}</span>
                <span class="sr">{s.role}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .pr {
    padding-block: var(--band-vast);
  }
  .pr-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .left h2 {
    margin-block-start: var(--s-4);
  }

  .ps {
    display: grid;
    margin-block-start: var(--s-7);
  }
  .ps li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: var(--s-3);
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--hair);
  }
  .ps li:last-child {
    border-block-end: 1px solid var(--hair);
  }
  .pn {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--emerald);
    padding-block-start: 0.35rem;
  }
  .ps h3 {
    font-size: 1.14rem;
    font-weight: 700;
    letter-spacing: var(--tr-tight);
  }
  .ps p {
    margin-block-start: 0.45rem;
    font-size: var(--t-sm);
    color: var(--ink-3);
    max-inline-size: 52ch;
  }

  /* toolkit — reads like an index, not a logo wall */
  .right {
    position: sticky;
    inset-block-start: 6.5rem;
    padding: var(--s-5);
    border-radius: var(--r-3);
    box-shadow: inset 0 0 0 1px var(--hair);
    background: color-mix(in srgb, #fff 3%, transparent);
  }
  .rl {
    margin-block: var(--s-4) var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .stk {
    display: grid;
  }
  .stk li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: 0.6rem;
    border-block-start: 1px solid var(--hair);
    transition: padding-inline-start var(--d-mid) var(--e-swift);
  }
  .stk li:hover {
    padding-inline-start: 0.5rem;
  }
  .sn {
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color var(--d-fast) var(--e-swift);
  }
  .stk li:hover .sn {
    color: var(--emerald);
  }
  .sr {
    font-size: var(--t-micro);
    color: var(--ink-4);
    text-align: end;
    white-space: nowrap;
  }

  @media (max-width: 940px) {
    .pr-grid {
      grid-template-columns: 1fr;
    }
    .right {
      position: static;
    }
  }
</style>
