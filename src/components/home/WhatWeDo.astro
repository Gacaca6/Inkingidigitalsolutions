---
import { services } from "../../data/site";
import Arrow from "../Arrow.astro";

// A compact emblem per service — the "believe what you see" cue on the card.
const glyphs: Record<string, string> = {
  "website-design": `<rect x="8" y="12" width="48" height="40" rx="5" class="ln"/><path d="M8 22h48" class="ln"/><circle cx="14" cy="17" r="1.6" class="fl"/><circle cx="19" cy="17" r="1.6" class="fl"/><rect x="14" y="29" width="20" height="4" rx="2" class="fl"/><rect x="14" y="37" width="30" height="3" rx="1.5" class="lnf"/><rect x="14" y="43" width="24" height="3" rx="1.5" class="lnf"/>`,
  "web-hosting": `<rect x="10" y="12" width="44" height="13" rx="3" class="ln"/><rect x="10" y="30" width="44" height="13" rx="3" class="ln"/><circle cx="17" cy="18.5" r="2" class="fl"/><circle cx="17" cy="36.5" r="2" class="fl"/><rect x="24" y="17" width="20" height="3" rx="1.5" class="lnf"/><rect x="24" y="35" width="20" height="3" rx="1.5" class="lnf"/><path d="M32 43v6M22 49h20" class="ln"/>`,
  "graphic-design": `<rect x="16" y="8" width="20" height="20" rx="5" class="fl" transform="rotate(45 26 18)"/><rect x="30" y="30" width="18" height="18" rx="4" class="ln"/><circle cx="20" cy="42" r="8" class="lnf2"/>`,
  "digital-marketing": `<path d="M10 46h44" class="ln"/><rect x="14" y="34" width="7" height="12" rx="2" class="lnf"/><rect x="26" y="26" width="7" height="20" rx="2" class="lnf"/><rect x="38" y="16" width="7" height="30" rx="2" class="fl"/><path d="M14 30l12-6 10 4 12-12" class="ln accent-stroke"/><circle cx="48" cy="16" r="2.4" class="fl"/>`,
};
---

<section class="wwd">
  <div class="page">
    <div class="wwd-head">
      <p class="tag" data-reveal><span class="idx">01</span> What we do</p>
      <h2 class="d1" data-reveal style="--rd:60ms">
        Everything a Rwandan business needs to
        <span class="accent">win online</span> — in one place.
      </h2>
      <p class="lead" data-reveal style="--rd:130ms">
        Four services, one team. Be found, look the part, and turn attention
        into customers. Pick one, or let us handle the lot.
      </p>
    </div>

    <div class="cards">
      {
        services.map((s, i) => (
          <a
            href={`/services/${s.slug}`}
            class="card"
            data-reveal
            style={`--rd:${120 + i * 80}ms`}
          >
            <div class="c-top">
              <svg viewBox="0 0 64 60" class="glyph" aria-hidden="true" set:html={glyphs[s.slug]} />
              <span class="c-idx num">{s.idx}</span>
            </div>
            <h3 class="c-name">{s.name}</h3>
            <p class="c-tag">{s.tagline}</p>
            <p class="c-sum">{s.summary}</p>
            <span class="c-go">
              Explore & pricing
              <Arrow />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wwd {
    padding-block: var(--band-vast) var(--band);
  }
  .wwd-head {
    max-inline-size: 40rem;
  }
  .wwd-head h2 {
    margin-block-start: var(--s-4);
    max-inline-size: 18ch;
  }
  .wwd-head .lead {
    margin-block-start: var(--s-4);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
    margin-block-start: var(--s-8);
  }

  .card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: var(--s-3);
    padding: var(--s-6);
    border-radius: var(--r-4);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: transform var(--d-slow) var(--e-swift),
      box-shadow var(--d-slow) var(--e-swift);
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: inset 0 0 0 1px var(--emerald), var(--lift-3);
  }

  .c-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .glyph {
    inline-size: 3.4rem;
    block-size: auto;
  }
  .glyph :global(.ln) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph :global(.lnf) {
    fill: var(--hair-2);
  }
  .glyph :global(.lnf2) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 2;
  }
  .glyph :global(.fl) {
    fill: var(--emerald);
  }
  .glyph :global(.accent-stroke) {
    stroke: var(--emerald);
  }
  .card:hover .glyph :global(.ln) {
    stroke: var(--emerald-2);
  }
  .c-idx {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--emerald-2);
  }

  .c-name {
    font-size: var(--t-d2);
    font-weight: 900;
    letter-spacing: var(--tr-tight);
    line-height: 1.05;
  }
  .c-tag {
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink);
  }
  .c-sum {
    font-size: var(--t-sm);
    color: var(--ink-3);
    line-height: 1.6;
    max-inline-size: 44ch;
  }
  .c-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--emerald-2);
  }
  .c-go :global(svg) {
    inline-size: 12px;
    block-size: 12px;
    transition: transform var(--d-mid) var(--e-swift);
  }
  .card:hover .c-go :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 820px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
