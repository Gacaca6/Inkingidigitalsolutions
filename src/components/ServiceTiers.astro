---
import Arrow from "./Arrow.astro";
import type { ServiceTier } from "../data/site";
interface Props {
  lede: string;
  tiers: ServiceTier[];
}
const { lede, tiers } = Astro.props;
---

<div class="st-wrap">
  <p class="st-lede body" data-reveal>{lede}</p>
  <div class="tiers">
    {
      tiers.map((t, i) => (
        <article
          class:list={["tier", { hero: t.featured }]}
          data-reveal
          style={`--rd:${i * 70}ms`}
        >
          {t.featured && <span class="flag">Most popular</span>}
          <header class="t-head">
            <h3>{t.name}</h3>
            <p class="t-note">{t.note}</p>
          </header>
          <p class="t-price">
            <span class="tv num">{t.price}</span>
            <span class="tu">{t.unit}</span>
          </p>
          <ul class="t-feats">
            {t.features.map((f) => (
              <li>
                <span class="tick">
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="m3 8.3 3.2 3.2L13 4.6"
                      stroke="currentColor"
                      stroke-width="2.1"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
          <a
            href="/contact"
            class:list={["btn t-cta", t.featured ? "accentbtn" : "ghost"]}
          >
            Get started
            <span class="well"><Arrow /></span>
          </a>
        </article>
      ))
    }
  </div>
</div>

<style>
  .st-lede {
    max-inline-size: 60ch;
    color: var(--ink-3);
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
    margin-block-start: var(--s-6);
    align-items: stretch;
  }
  .tier {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-5) var(--s-5);
    border-radius: var(--r-3);
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: transform var(--d-slow) var(--e-swift),
      box-shadow var(--d-slow) var(--e-swift);
  }
  .tier:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--hair-2), var(--lift-2);
  }
  .tier.hero {
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1.5px var(--emerald), var(--lift-2);
  }

  .flag {
    position: absolute;
    inset-block-start: -0.7rem;
    inset-inline-start: var(--s-5);
    padding: 0.24rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--emerald);
    color: var(--on-accent);
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .t-head h3 {
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: var(--tr-tight);
  }
  .t-note {
    margin-block-start: 0.35rem;
    font-size: var(--t-xs);
    color: var(--ink-4);
  }

  .t-price {
    display: grid;
    gap: 0.2rem;
    padding-block-end: var(--s-4);
    border-block-end: 1px solid var(--hair);
  }
  .tv {
    font-size: 1.7rem;
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--emerald-2);
  }
  .tu {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-4);
  }

  .t-feats {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .t-feats li {
    display: grid;
    grid-template-columns: 1.15rem 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: var(--t-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .tick {
    display: grid;
    place-items: center;
    inline-size: 1.15rem;
    block-size: 1.15rem;
    border-radius: 50%;
    background: var(--emerald-wash);
    margin-block-start: 0.05rem;
  }
  .tick svg {
    inline-size: 10px;
    block-size: 10px;
    color: var(--emerald-2);
  }
  .t-cta {
    justify-content: space-between;
  }

  @media (max-width: 980px) {
    .tiers {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      max-inline-size: 30rem;
    }
  }
</style>
