---
import Mark from "./Mark.astro";
import { site } from "../data/site";
import { langOf, href } from "../i18n";
import { t } from "../i18n/strings";
import { dataFor } from "../i18n/data";
const year = new Date().getFullYear();
const lang = langOf(Astro.url);
const f = t(lang).footer;
const { services, city, hours } = dataFor(lang);
const to = (p: string) => href(p, lang);
---

<footer class="ft on-navy">
  <div class="page">
    <!-- Editorial statement -->
    <div class="say">
      <p class="hero-type" data-reveal set:html={f.statement} />
      <div class="say-side" data-reveal style="--rd:120ms">
        <p class="body">{f.about}</p>
        <form
          class="sub"
          data-newsletter
          data-endpoint={`https://formsubmit.co/ajax/${site.email}`}
          novalidate
        >
          <div class="sub-row">
            <label for="nl" class="sr">{f.emailLabel}</label>
            <input
              id="nl"
              class="input"
              type="email"
              name="email"
              required
              placeholder="you@company.rw"
              autocomplete="email"
            />
            <button class="sub-go" type="submit">
              <span>{f.subscribe}</span>
            </button>
          </div>
          <p class="err" data-err>{f.invalid}</p>
          <p class="xs sub-note">{f.note}</p>
          <p class="err on" data-nl-fail hidden>
            {f.failBefore}
            <a href={`mailto:${site.email}?subject=Newsletter`}>{site.email}</a>
            {f.failAfter}
          </p>
          <p class="done" data-done hidden>
            <span class="tick" aria-hidden="true"></span>
            {f.done}
          </p>
        </form>
      </div>
    </div>

    <!-- Columns -->
    <div class="cols">
      <div>
        <p class="ch">{f.services}</p>
        <ul class="cl">
          {services.map((sv) => (
            <li><a href={to(`/services/${sv.slug}`)}>{sv.name}</a></li>
          ))}
          <li><a href={to("/pricing")}>{f.pricing}</a></li>
        </ul>
      </div>
      <div>
        <p class="ch">{f.company}</p>
        <ul class="cl">
          <li><a href={to("/about")}>{f.about_}</a></li>
          <li><a href={to("/insights")}>{f.insights}</a></li>
          <li><a href={to("/contact")}>{f.contact}</a></li>
        </ul>
      </div>
      <div>
        <p class="ch">{f.reach}</p>
        <ul class="cl">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.phones.map((p) => (
            <li><a href={`tel:${p.replace(/\s/g, "")}`}>{p}</a></li>
          ))}
          {site.socials.map((x) => (
            <li>
              <a href={x.url} target="_blank" rel="noopener me">{x.label}</a>
            </li>
          ))}
          <li class="plain">{city}</li>
          <li class="plain">{hours}</li>
        </ul>
      </div>
      <div class="concept">
        <Mark size={40} />
        <p class="xs">{f.concept}</p>
      </div>
    </div>

    <div class="base">
      <p class="xs">© {year} {site.name} {f.rights}</p>
      <p class="xs num">{f.engineered} · 1°56′S 30°03′E</p>
    </div>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    padding-block: var(--band) var(--s-7);
    overflow: hidden;
  }

  .say {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s-8);
    align-items: end;
    padding-block-end: var(--s-9);
    border-block-end: 1px solid var(--hair);
  }
  .say-side {
    display: grid;
    gap: var(--s-5);
  }

  .sub-row {
    display: flex;
    gap: 0.5rem;
    max-inline-size: 26rem;
  }
  .sub-row .input {
    background: color-mix(in srgb, #fff 6%, transparent);
    border-color: var(--hair-2);
  }
  .sub-go {
    padding: 0 1.15rem;
    border-radius: var(--r-2);
    background: var(--emerald);
    color: var(--on-accent);
    font-size: var(--t-xs);
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--d-mid) var(--e-swift),
      transform 150ms var(--e-swift);
  }
  .sub-go:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .sub-go:active {
    transform: scale(0.97);
  }
  .sub-note {
    color: var(--ink-4);
    max-inline-size: 34ch;
  }
  .done {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-sm);
    color: var(--emerald);
  }
  .tick {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 2px;
    rotate: 45deg;
    background: var(--emerald);
    flex: none;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-8);
  }
  .ch {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tr-wide);
    color: var(--ink-4);
  }
  .cl {
    display: grid;
    gap: 0.7rem;
    margin-block-start: var(--s-4);
    font-size: var(--t-sm);
  }
  .cl a {
    color: var(--ink-2);
    overflow-wrap: anywhere; /* the email address, on a 320px phone */
    transition: color var(--d-fast) var(--e-swift);
  }
  .cl a:hover {
    color: var(--emerald);
  }
  .cl .plain {
    color: var(--ink-4);
  }
  .concept {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .concept p {
    color: var(--ink-4);
    max-inline-size: 30ch;
  }

  .base {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--hair);
    color: var(--ink-4);
  }

  @media (max-width: 900px) {
    .say {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .cols {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-7) var(--s-5);
    }
  }
  @media (max-width: 400px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .sub-row {
      flex-direction: column;
    }
    .sub-go {
      padding-block: 0.85rem;
    }
  }
</style>

<script>
  /* Newsletter sign-up.
     This used to show "You are on the list" without sending the address
     anywhere, so every sign-up was silently lost. It now goes to the same
     FormSubmit inbox as the contact form, and only says "done" once that
     inbox has actually accepted it. */
  const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>("input[type=email]")!;
    const err = form.querySelector<HTMLElement>("[data-err]")!;
    const fail = form.querySelector<HTMLElement>("[data-nl-fail]")!;
    const go = form.querySelector<HTMLButtonElement>(".sub-go")!;
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(input.value.trim());
    input.setAttribute("aria-invalid", String(!ok));
    err.classList.toggle("on", !ok);
    fail.hidden = true;
    if (!ok) {
      input.focus();
      return;
    }

    const body = new FormData();
    body.append("email", input.value.trim());
    body.append("_subject", "Newsletter sign-up — inkingidigitalsolutions.rw");
    body.append("_template", "table");
    body.append("_captcha", "false");

    go.disabled = true;
    go.setAttribute("aria-busy", "true");
    try {
      const res = await fetch(form.dataset.endpoint!, {
        method: "POST",
        headers: { Accept: "application/json" },
        body,
      });
      const json = await res.json().catch(() => ({}));
      if (!(res.ok && (json.success === "true" || json.success === true))) throw new Error();
      form.querySelector<HTMLElement>(".sub-row")!.hidden = true;
      form.querySelector<HTMLElement>(".sub-note")!.hidden = true;
      form.querySelector<HTMLElement>("[data-done]")!.hidden = false;
    } catch {
      fail.hidden = false;
    } finally {
      go.disabled = false;
      go.setAttribute("aria-busy", "false");
    }
  });
</script>
