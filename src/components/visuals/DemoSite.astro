---
/* A site, shown as a site: browser frame, page scrolling itself, load budget met. */
---

<div class="wrap" aria-hidden="true">
  <div class="tray">
    <div class="plate">
      <div class="chrome">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">
          <svg viewBox="0 0 24 24" fill="none" class="lock">
            <rect x="5" y="11" width="14" height="9" rx="2.5" stroke="currentColor" stroke-width="1.7"></rect>
            <path d="M8.5 11V8a3.5 3.5 0 0 1 7 0v3" stroke="currentColor" stroke-width="1.7"></path>
          </svg>
          muhirwa-coffee.rw
        </span>
      </div>

      <div class="view">
        <div class="reel">
          <!-- hero -->
          <section class="sc sc-hero">
            <div class="nav">
              <b></b><i></i><i></i><i></i><u></u>
            </div>
            <h4>Grown at 1,900 m.<br />Roasted in Kigali.</h4>
            <p></p><p class="short"></p>
            <div class="btns"><span class="b1"></span><span class="b2"></span></div>
          </section>
          <!-- cards -->
          <section class="sc sc-grid">
            <div class="ttl"></div>
            <div class="cards">
              <div class="cd"><span class="im"></span><b></b><i></i></div>
              <div class="cd"><span class="im g"></span><b></b><i></i></div>
              <div class="cd"><span class="im"></span><b></b><i></i></div>
            </div>
          </section>
          <!-- split -->
          <section class="sc sc-split">
            <div class="col">
              <b></b><i></i><i></i><i class="s"></i>
            </div>
            <span class="im tall g"></span>
          </section>
          <!-- foot -->
          <section class="sc sc-foot">
            <b></b>
            <div class="fl"><i></i><i></i><i></i><i></i></div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <div class="badge">
    <span class="ring">
      <svg viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="17" class="tr"></circle>
        <circle cx="20" cy="20" r="17" class="vl"></circle>
      </svg>
      <b class="num">100</b>
    </span>
    <span class="badge-t">
      <b>Performance</b>
      <i class="num">0.4 s to first paint · 3G</i>
    </span>
  </div>
</div>

<style>
  .wrap {
    position: relative;
    inline-size: 100%;
  }
  .plate {
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.7rem 0.9rem;
    border-block-end: 1px solid var(--hair);
    background: color-mix(in srgb, var(--ink) 2.5%, var(--paper-2));
  }
  .dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--hair-2);
  }
  .url {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-inline-start: 0.7rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  .lock {
    inline-size: 9px;
    block-size: 9px;
    color: var(--emerald-2);
  }

  .view {
    block-size: 20rem;
    overflow: hidden;
    background: var(--paper-2);
  }
  .reel {
    animation: reel 17s var(--e-io) infinite;
  }
  @keyframes reel {
    0%,
    12% {
      transform: translateY(0);
    }
    26%,
    38% {
      transform: translateY(-20rem);
    }
    52%,
    64% {
      transform: translateY(-40rem);
    }
    78%,
    90% {
      transform: translateY(-60rem);
    }
    100% {
      transform: translateY(0);
    }
  }

  .sc {
    block-size: 20rem;
    padding: 1.1rem 1.3rem;
    display: grid;
    align-content: center;
    gap: 0.55rem;
  }

  /* generic bars */
  .sc b,
  .sc i,
  .sc p,
  .sc u {
    display: block;
    border-radius: 3px;
    background: var(--hair);
  }
  .sc b {
    block-size: 8px;
    inline-size: 42%;
    background: color-mix(in srgb, var(--ink) 24%, transparent);
  }
  .sc i {
    block-size: 5px;
    inline-size: 78%;
  }
  .sc i.s {
    inline-size: 46%;
  }
  .sc p {
    block-size: 5px;
    inline-size: 62%;
  }
  .sc p.short {
    inline-size: 40%;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-block-end: 1rem;
  }
  .nav b {
    inline-size: 34px;
    block-size: 9px;
    background: var(--ink);
  }
  .nav i {
    inline-size: 22px;
    block-size: 4px;
  }
  .nav u {
    margin-inline-start: auto;
    inline-size: 44px;
    block-size: 15px;
    border-radius: var(--r-pill);
    background: var(--emerald);
  }

  .sc-hero h4 {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin-block-end: 0.3rem;
  }
  .btns {
    display: flex;
    gap: 6px;
    margin-block-start: 0.6rem;
  }
  .b1,
  .b2 {
    block-size: 17px;
    border-radius: var(--r-pill);
  }
  .b1 {
    inline-size: 62px;
    background: var(--ink);
  }
  .b2 {
    inline-size: 48px;
    box-shadow: inset 0 0 0 1px var(--hair-2);
  }

  .ttl {
    inline-size: 38%;
    block-size: 8px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink) 24%, transparent);
    margin-block-end: 0.4rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .cd {
    display: grid;
    gap: 5px;
    padding: 7px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--hair);
  }
  .cd b {
    inline-size: 70%;
    block-size: 5px;
  }
  .cd i {
    inline-size: 90%;
    block-size: 4px;
  }
  .im {
    display: block;
    block-size: 42px;
    border-radius: 5px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--ink) 12%, transparent),
      color-mix(in srgb, var(--ink) 4%, transparent)
    );
  }
  .im.g {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--emerald) 40%, transparent),
      color-mix(in srgb, var(--emerald) 10%, transparent)
    );
  }
  .im.tall {
    block-size: 100%;
    min-block-size: 118px;
  }

  .sc-split {
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 12px;
  }
  .sc-split .col {
    display: grid;
    gap: 6px;
  }

  .sc-foot {
    align-content: end;
  }
  .fl {
    display: flex;
    gap: 10px;
  }
  .fl i {
    inline-size: 34px;
    block-size: 4px;
  }

  /* perf badge — a real measure, not decoration */
  .badge {
    position: absolute;
    inset-block-end: -0.9rem;
    inset-inline-start: -0.9rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--hair), var(--lift-2);
  }
  .ring {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.35rem;
    block-size: 2.35rem;
  }
  .ring svg {
    position: absolute;
    inset: 0;
    rotate: -90deg;
  }
  .ring circle {
    fill: none;
    stroke-width: 3.4;
    stroke-linecap: round;
  }
  .tr {
    stroke: var(--hair);
  }
  .vl {
    stroke: var(--emerald);
    stroke-dasharray: 107;
    stroke-dashoffset: 107;
    animation: fill 2.2s var(--e-out) 0.5s forwards;
  }
  @keyframes fill {
    to {
      stroke-dashoffset: 0;
    }
  }
  .ring b {
    font-size: 0.66rem;
    font-weight: 900;
    color: var(--emerald-2);
  }
  .badge-t {
    display: grid;
    line-height: 1.3;
  }
  .badge-t b {
    font-size: 0.7rem;
    font-weight: 700;
  }
  .badge-t i {
    font-size: 0.62rem;
    font-style: normal;
    color: var(--ink-3);
  }

  @media (max-width: 560px) {
    .view {
      block-size: 15rem;
    }
    .sc {
      block-size: 15rem;
      padding: 0.85rem 1rem;
    }
    @keyframes reel {
      0%, 12% { transform: translateY(0); }
      26%, 38% { transform: translateY(-15rem); }
      52%, 64% { transform: translateY(-30rem); }
      78%, 90% { transform: translateY(-45rem); }
      100% { transform: translateY(0); }
    }
    .badge {
      inset-inline-start: 0;
      inset-block-end: -1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel {
      animation: none;
    }
    .vl {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
