---
/* Digital marketing shown as a growth panel: reach chart, metrics, channels. */
const area = [18, 24, 21, 33, 30, 44, 52, 61, 58, 74, 82, 96];
const w = 300;
const h = 96;
const max = 100;
const pts = area
  .map((v, i) => `${(i / (area.length - 1)) * w},${h - (v / max) * h}`)
  .join(" ");
const chans = ["Instagram", "Facebook", "Google", "TikTok"];
---

<div class="mk" aria-hidden="true">
  <div class="tray">
    <div class="plate">
      <div class="head">
        <b>Campaign performance</b>
        <span class="live"><em></em>This month</span>
      </div>

      <div class="mets">
        <div class="met">
          <i>Reach</i>
          <b class="num">128,400</b>
          <u class="up num">↑ 34%</u>
        </div>
        <div class="met">
          <i>Leads</i>
          <b class="num">312</b>
          <u class="up num">↑ 21%</u>
        </div>
        <div class="met">
          <i>Cost / lead</i>
          <b class="num">1,480<small> RWF</small></b>
          <u class="down num">↓ 12%</u>
        </div>
      </div>

      <div class="chart">
        <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" class="area">
          <defs>
            <linearGradient id="mkfill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--emerald)" stop-opacity="0.28" />
              <stop offset="1" stop-color="var(--emerald)" stop-opacity="0" />
            </linearGradient>
          </defs>
          <polygon points={`0,${h} ${pts} ${w},${h}`} fill="url(#mkfill)" class="fill" />
          <polyline points={pts} fill="none" stroke="var(--emerald)" stroke-width="2.5" class="line" />
        </svg>
      </div>

      <div class="chans">
        {chans.map((c, i) => (
          <span class="ch" style={`--cd:${400 + i * 120}ms`}>
            <em></em>{c}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .mk { inline-size: 100%; }
  .plate {
    padding: 1.1rem 1.2rem 1.2rem;
    display: grid;
    gap: 0.9rem;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .head b {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--emerald-2);
  }
  .live em {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--emerald);
    animation: beat 2.4s var(--e-io) infinite;
  }
  @keyframes beat {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .mets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .met {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--r-2);
    background: color-mix(in srgb, var(--ink) 3%, transparent);
  }
  .met i {
    font-size: 0.56rem;
    font-style: normal;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-4);
  }
  .met b {
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .met b small {
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--ink-3);
  }
  .met u {
    font-size: 0.58rem;
    font-weight: 700;
    text-decoration: none;
  }
  .up { color: var(--emerald-2); }
  .down { color: var(--emerald-2); }

  .chart {
    block-size: 4rem;
  }
  .area {
    inline-size: 100%;
    block-size: 100%;
  }
  .line {
    stroke-dasharray: 640;
    stroke-dashoffset: 640;
    animation: draw 1.8s var(--e-out) 0.3s forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .fill {
    opacity: 0;
    animation: fade 1s var(--e-out) 1.1s forwards;
  }
  @keyframes fade { to { opacity: 1; } }

  .chans {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-block-start: 0.7rem;
    border-block-start: 1px solid var(--hair);
  }
  .ch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--ink-2);
    opacity: 0;
    transform: translateY(6px);
    animation: chin 0.5s var(--e-out) forwards;
    animation-delay: var(--cd);
  }
  @keyframes chin { to { opacity: 1; transform: none; } }
  .ch em {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 2px;
    rotate: 45deg;
    background: var(--emerald);
  }

  @media (prefers-reduced-motion: reduce) {
    .line { stroke-dashoffset: 0; animation: none; }
    .fill, .ch { opacity: 1; transform: none; animation: none; }
    .live em { animation: none; }
  }
</style>
