---
import Mark from "./Mark.astro";
import { nav, site, services } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const waNumber = site.whatsapp.replace(/[^\d]/g, "");
---

<header class="hdr" data-hdr>
  <!-- Tier 1 — utility strip -->
  <div class="util">
    <div class="util-in">
      <p class="util-left">
        <span class="dot" aria-hidden="true"></span>
        {site.city} · {site.hours}
      </p>
      <div class="util-right">
        {
          site.phones.map((p, i) => (
            <a
              href={`tel:${p.replace(/\s/g, "")}`}
              class:list={["u-item", { "u-phone2": i === 1 }]}
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M6.5 4h-2A1.5 1.5 0 0 0 3 5.6C3 13 11 21 18.4 21A1.5 1.5 0 0 0 20 19.5v-2a1.3 1.3 0 0 0-1-1.3l-2.7-.6a1.3 1.3 0 0 0-1.3.5l-.6.8a11 11 0 0 1-4.5-4.5l.8-.6a1.3 1.3 0 0 0 .5-1.3l-.6-2.7A1.3 1.3 0 0 0 6.5 4Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{p}</span>
            </a>
          ))
        }
        <a
          href={`https://wa.me/${waNumber}`}
          class="u-item"
          target="_blank"
          rel="noopener"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3.5A8.5 8.5 0 0 0 4.2 16l-1 4.3 4.4-1A8.5 8.5 0 1 0 12 3.5Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
            <path
              d="M9 8.5c-.3 0-.6.1-.8.4-.3.3-.9.9-.9 2s.9 2.3 1 2.5c.1.2 1.7 2.8 4.3 3.7 2.1.8 2.6.7 3 .6.5-.1 1.4-.6 1.6-1.2.2-.6.2-1 .1-1.2l-.7-.4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>WhatsApp</span>
        </a>
        <a href={`mailto:${site.email}`} class="u-item u-email">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="2.5"
              stroke="currentColor"
              stroke-width="1.6"></rect>
            <path
              d="m4 7 8 6 8-6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
          <span>{site.email}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Tier 2 — main nav -->
  <div class="bar">
    <div class="bar-in">
      <a href="/" class="brand" aria-label="Inkingi Digital Solutions — home">
        <Mark size={32} />
        <span class="brand-txt">
          <span class="brand-name">inkingi</span>
          <span class="brand-sub">Digital Solutions</span>
        </span>
      </a>

      <nav class="links" aria-label="Primary">
        {
          nav.map((l) =>
            l.children ? (
              <div class="has-menu" data-dd>
                <button
                  class:list={["link", "dd-btn", { on: isActive(l.href) }]}
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {l.label}
                  <svg viewBox="0 0 12 12" fill="none" class="caret" aria-hidden="true">
                    <path
                      d="m2.5 4.5 3.5 3.5 3.5-3.5"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class="menu" data-dd-panel>
                  <div class="menu-in">
                    {services.map((s) => (
                      <a href={`/services/${s.slug}`} class="mi">
                        <span class="mi-idx num">{s.idx}</span>
                        <span class="mi-txt">
                          <span class="mi-name">{s.name}</span>
                          <span class="mi-tag">{s.tagline}</span>
                        </span>
                        <span class="mi-go" aria-hidden="true">→</span>
                      </a>
                    ))}
                    <a href="/services" class="mi mi-all">
                      <span class="mi-txt">
                        <span class="mi-name">All services & pricing</span>
                      </span>
                      <span class="mi-go" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a href={l.href} class:list={["link", { on: isActive(l.href) }]}>
                {l.label}
              </a>
            )
          )
        }
      </nav>

      <div class="acts">
        <button class="icn" data-theme-toggle aria-label="Switch colour theme">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="i-sun">
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path
              d="M12 2.8v2.4M12 18.8v2.4M21.2 12h-2.4M5.2 12H2.8M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7M18.5 18.5l-1.7-1.7M7.2 7.2 5.5 5.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="i-moon">
            <path
              d="M20.4 14.6A8.6 8.6 0 0 1 9.4 3.6a8.6 8.6 0 1 0 11 11Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
        </button>

        <a href="/contact" class="cta">Get a quote</a>

        <button
          class="burger"
          data-menu-toggle
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile sheet -->
<div class="sheet" id="mobile-menu" data-menu hidden>
  <nav class="sheet-nav" aria-label="Mobile">
    {
      nav.map((l, i) =>
        l.children ? (
          <div class="sheet-group" style={`--i:${i}`}>
            <details>
              <summary>
                <span>{l.label}</span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="sheet-sub">
                {l.children.map((c) => (
                  <a href={c.href}>{c.label}</a>
                ))}
                <a href="/services" class="sub-all">All services & pricing</a>
              </div>
            </details>
          </div>
        ) : (
          <a href={l.href} class="sheet-link" style={`--i:${i}`}>
            <span>{l.label}</span>
            <i aria-hidden="true"></i>
          </a>
        )
      )
    }
  </nav>
  <div class="sheet-foot">
    {
      site.phones.map((p) => (
        <a href={`tel:${p.replace(/\s/g, "")}`}>{p}</a>
      ))
    }
    <a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener">WhatsApp</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<style>
  .hdr {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
  }

  /* ---- Tier 1: utility ---- */
  .util {
    background: var(--paper-3);
    border-block-end: 1px solid var(--hair);
    font-size: var(--t-micro);
    transition: margin-block-start var(--d-slow) var(--e-out),
      opacity var(--d-mid) var(--e-out);
  }
  .util-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    inline-size: min(100%, var(--page-wide));
    margin-inline: auto;
    padding: 0.4rem var(--gut);
  }
  .util-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-3);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .util-left .dot {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 1.5px;
    rotate: 45deg;
    background: var(--emerald);
  }
  .util-right {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .u-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-2);
    font-weight: 600;
    transition: color var(--d-fast) var(--e-swift);
  }
  .u-item:hover {
    color: var(--emerald-2);
  }
  .u-item svg {
    inline-size: 13px;
    block-size: 13px;
    color: var(--emerald-2);
  }

  /* Header lifts: hide the utility strip, tighten the bar */
  :global([data-hdr].lifted) .util {
    margin-block-start: -2.2rem;
    opacity: 0;
    pointer-events: none;
  }

  /* ---- Tier 2: main bar ---- */
  .bar {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-block-end: 1px solid transparent;
    transition: border-color var(--d-slow) var(--e-out),
      box-shadow var(--d-slow) var(--e-out);
  }
  :global([data-hdr].lifted) .bar {
    border-block-end-color: var(--hair);
    box-shadow: var(--lift-1);
  }
  .bar-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    inline-size: min(100%, var(--page-wide));
    margin-inline: auto;
    padding: 0.7rem var(--gut);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }
  .brand :global(.mark) {
    transition: rotate var(--d-slow) var(--e-out);
  }
  .brand:hover :global(.mark) {
    rotate: 12deg;
  }
  .brand-txt {
    display: grid;
    line-height: 1;
  }
  .brand-name {
    font-size: 1.08rem;
    font-weight: 900;
    letter-spacing: -0.035em;
  }
  .brand-sub {
    margin-block-start: 3px;
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--emerald-2);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(0.3rem, 1.4vw, 1.1rem);
  }
  .link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--r-1);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-2);
    transition: color var(--d-mid) var(--e-swift),
      background-color var(--d-mid) var(--e-swift);
  }
  .link:hover {
    color: var(--ink);
  }
  .link.on {
    color: var(--ink);
    font-weight: 700;
  }
  .link.on::after {
    content: "";
    position: absolute;
    inset-block-end: 1px;
    inset-inline-start: 50%;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 1.5px;
    rotate: 45deg;
    translate: -50% 0;
    background: var(--emerald);
  }
  .dd-btn {
    background: none;
    cursor: pointer;
    font: inherit;
  }
  .caret {
    inline-size: 11px;
    block-size: 11px;
    transition: transform var(--d-mid) var(--e-swift);
  }

  /* ---- Dropdown ---- */
  .has-menu {
    position: relative;
  }
  .menu {
    position: absolute;
    inset-block-start: calc(100% + 0.55rem);
    inset-inline-start: -0.5rem;
    inline-size: 22rem;
    max-inline-size: calc(100vw - 2rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--d-mid) var(--e-swift),
      transform var(--d-mid) var(--e-swift), visibility var(--d-mid);
  }
  .has-menu.open .menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .has-menu.open .caret {
    transform: rotate(180deg);
  }
  .menu-in {
    padding: 0.5rem;
    border-radius: var(--r-3);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--hair), var(--lift-3);
  }
  .mi {
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.8rem;
    border-radius: var(--r-2);
    transition: background-color var(--d-fast) var(--e-swift);
  }
  .mi:hover {
    background: var(--emerald-wash);
  }
  .mi-idx {
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--emerald-2);
  }
  .mi-txt {
    display: grid;
    gap: 0.1rem;
  }
  .mi-name {
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .mi-tag {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }
  .mi-go {
    color: var(--emerald-2);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--d-fast), transform var(--d-fast) var(--e-swift);
  }
  .mi:hover .mi-go {
    opacity: 1;
    transform: none;
  }
  .mi-all {
    grid-template-columns: 1fr auto;
    margin-block-start: 0.25rem;
    border-block-start: 1px solid var(--hair);
    border-radius: 0 0 var(--r-2) var(--r-2);
    color: var(--ink);
  }
  .mi-all .mi-name {
    color: var(--emerald-2);
  }

  .acts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  .icn {
    display: grid;
    place-items: center;
    inline-size: 2.15rem;
    block-size: 2.15rem;
    border-radius: 50%;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: color var(--d-mid) var(--e-swift),
      box-shadow var(--d-mid) var(--e-swift);
  }
  .icn:hover {
    color: var(--emerald-2);
    box-shadow: inset 0 0 0 1px var(--emerald);
  }
  .icn svg {
    inline-size: 15px;
    block-size: 15px;
  }
  .i-moon {
    display: none;
  }
  :global([data-theme="dark"]) .i-sun {
    display: none;
  }
  :global([data-theme="dark"]) .i-moon {
    display: block;
  }

  .cta {
    padding: 0.6rem 1.2rem;
    border-radius: var(--r-pill);
    background: var(--emerald);
    color: var(--on-accent);
    font-size: var(--t-xs);
    font-weight: 700;
    white-space: nowrap;
    transition: background-color var(--d-mid) var(--e-swift),
      transform 150ms var(--e-swift);
  }
  .cta:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .cta:active {
    transform: scale(0.97);
  }

  .burger {
    display: none;
    place-items: center;
    inline-size: 2.15rem;
    block-size: 2.15rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--hair);
    position: relative;
  }
  .burger span {
    position: absolute;
    inline-size: 15px;
    block-size: 1.6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--d-mid) var(--e-swift);
  }
  .burger span:nth-child(1) {
    transform: translateY(-3.2px);
  }
  .burger span:nth-child(2) {
    transform: translateY(3.2px);
  }
  .burger[aria-expanded="true"] span:nth-child(1) {
    transform: rotate(45deg);
  }
  .burger[aria-expanded="true"] span:nth-child(2) {
    transform: rotate(-45deg);
  }

  /* ---- Sheet ---- */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 6rem var(--gut) var(--gut);
    opacity: 0;
    transition: opacity var(--d-mid) var(--e-out);
    overflow-y: auto;
  }
  .sheet.open {
    opacity: 1;
  }
  .sheet-nav {
    display: grid;
    align-content: start;
    inline-size: min(100%, var(--page));
    margin-inline: auto;
    width: 100%;
  }
  .sheet-link,
  .sheet-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    border-block-end: 1px solid var(--hair);
    font-size: clamp(1.5rem, 6.5vw, 2.2rem);
    font-weight: 900;
    letter-spacing: var(--tr-tight);
    cursor: pointer;
    list-style: none;
  }
  .sheet-group summary::-webkit-details-marker {
    display: none;
  }
  .sheet-link,
  .sheet-group {
    opacity: 0;
    transform: translateY(16px);
  }
  .sheet.open .sheet-link,
  .sheet.open .sheet-group {
    animation: sheetIn 0.6s var(--e-out) forwards;
    animation-delay: calc(60ms + var(--i) * 45ms);
  }
  .sheet-link i,
  .sheet-group summary i {
    inline-size: 8px;
    block-size: 8px;
    border-radius: 2px;
    rotate: 45deg;
    background: var(--emerald);
    transition: transform var(--d-mid) var(--e-swift);
  }
  .sheet-group[open] summary i {
    transform: rotate(45deg) scale(1.3);
    background: var(--ink-3);
  }
  .sheet-sub {
    display: grid;
    padding-block: 0.4rem 1rem;
  }
  .sheet-sub a {
    padding-block: 0.7rem;
    padding-inline-start: 0.2rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .sheet-sub a:hover {
    color: var(--emerald-2);
  }
  .sheet-sub .sub-all {
    color: var(--emerald-2);
    font-weight: 700;
  }
  @keyframes sheetIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .sheet-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    inline-size: min(100%, var(--page));
    margin-inline: auto;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--hair);
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .sheet-foot a {
    color: var(--ink-2);
  }
  .sheet-foot a:hover {
    color: var(--emerald-2);
  }

  @media (max-width: 1260px) {
    .u-email {
      display: none;
    }
  }
  @media (max-width: 1080px) {
    .u-phone2 {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    .links {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
  @media (max-width: 700px) {
    .util-left {
      display: none;
    }
    .util-in {
      justify-content: center;
    }
  }
  @media (max-width: 520px) {
    .cta {
      display: none;
    }
    .brand-sub {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet.open .sheet-link,
    .sheet.open .sheet-group {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Header lift — hides the utility strip after a small scroll
  const hdr = document.querySelector("[data-hdr]");
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      hdr?.classList.toggle("lifted", window.scrollY > 18);
      ticking = false;
    });
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Desktop dropdown — hover + focus + click, keyboard accessible
  document.querySelectorAll<HTMLElement>("[data-dd]").forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>(".dd-btn")!;
    const open = () => {
      dd.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dd.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    };
    dd.addEventListener("mouseenter", open);
    dd.addEventListener("mouseleave", close);
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      dd.classList.contains("open") ? close() : open();
    });
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains(e.relatedTarget as Node)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  });

  // Mobile sheet
  const burger = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const sheet = document.querySelector<HTMLElement>("[data-menu]");
  const setMenu = (open: boolean) => {
    if (!burger || !sheet) return;
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add("open"));
    } else {
      sheet.classList.remove("open");
      setTimeout(() => {
        sheet.hidden = true;
      }, 420);
    }
  };
  burger?.addEventListener("click", () =>
    setMenu(burger.getAttribute("aria-expanded") !== "true")
  );
  sheet?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && burger?.getAttribute("aria-expanded") === "true")
      setMenu(false);
  });

  // Theme
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("inkingi-theme", next);
    } catch {}
  });
</script>
