---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Journey from "../components/home/Journey.astro";
import Cta from "../components/Cta.astro";
import { principles } from "../data/site";

const refusals = [
  {
    t: "We won't sell you what you don't need",
    b: "Plenty of businesses come asking for an expensive site when a sharp landing page and better marketing would serve them far better. When that's true, we say so — and quote the smaller job.",
  },
  {
    t: "We won't hold your business hostage",
    b: "You own your domain, your files, your accounts. Everything is set up so another firm could take over tomorrow. Staying with us should be a choice you keep making, not a trap.",
  },
  {
    t: "We won't disappear after launch",
    b: "Launch is the middle of the work, not the end. We host what we build and stay on to look after it — because a site nobody maintains quietly stops working.",
  },
  {
    t: "We won't promise what we can't deliver",
    b: "If a deadline isn't realistic, we say so up front, not halfway through the build. We'd rather lose the job to someone promising faster than let you down later.",
  },
];
---

<Base
  title="About"
  description="Inkingi Digital Solutions is a digital studio in Kigali — website design, hosting, branding, and marketing — held to the standard of the world's best."
>
  <PageHead
    idx="01"
    label="About"
    title='Quiet confidence, <span class="accent">earned</span> in the work.'
    lede="We're a digital studio in Kigali. We design websites, host and look after them, build brands, and help Rwandan businesses get found — at a standard we're proud to sign."
  />

  <!-- The premise -->
  <section class="premise">
    <div class="page prem-in">
      <div>
        <p class="rule d3" data-reveal>
          The failure mode of a website project isn't bad code. It's building
          the wrong thing beautifully.
        </p>
      </div>
      <div class="prem-body">
        <p class="body" data-reveal style="--rd:80ms">
          Plenty of sites out there were competently made — the pages load, the
          design is fine — and still bring in nothing. Almost always it's
          because nobody asked what the business actually needed before deciding
          what to build, so the site speaks to customers who aren't there.
        </p>
        <p class="body" data-reveal style="--rd:140ms">
          That's why we start every job with a real conversation, not a
          template. What you sell, who you sell to, and what's getting in the
          way. Everything after — the design, the words, the price — is only as
          good as what we learn there.
        </p>
      </div>
    </div>
  </section>

  <Journey />

  <!-- Refusals — the trust section -->
  <section class="ref">
    <div class="page">
      <p class="tag" data-reveal><span class="idx">04</span> What we refuse</p>
      <h2 class="d1" data-reveal style="--rd:60ms">
        Trust is mostly<br />a list of noes.
      </h2>
      <div class="rgrid">
        {
          refusals.map((r, i) => (
            <div class="rcell" data-reveal style={`--rd:${i * 70}ms`}>
              <span class="rn num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{r.t}</h3>
              <p>{r.b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="pcs on-navy">
    <div class="page">
      <p class="tag" data-reveal><span class="idx">05</span> What we hold to</p>
      <ul class="plist">
        {
          principles.map((p, i) => (
            <li data-reveal style={`--rd:${i * 60}ms`}>
              <span class="pn num">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .premise {
    padding-block: var(--band-tight) var(--band);
  }
  .prem-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .prem-in .d3 {
    max-inline-size: 22ch;
    font-size: var(--t-d2);
    line-height: 1.22;
  }
  .prem-body {
    display: grid;
    gap: var(--s-5);
  }

  .ref {
    padding-block: var(--band);
  }
  .ref h2 {
    margin-block-start: var(--s-4);
  }
  .rgrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7) clamp(2rem, 6vw, 5rem);
    margin-block-start: var(--s-8);
  }
  .rgrid > :nth-child(even) {
    margin-block-start: var(--s-7);
  }
  .rcell {
    display: grid;
    gap: 0.7rem;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--hair);
  }
  .rn {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--emerald-2);
  }
  .rcell h3 {
    font-size: var(--t-d3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
    max-inline-size: 22ch;
  }
  .rcell p {
    font-size: var(--t-sm);
    color: var(--ink-3);
    max-inline-size: 48ch;
  }

  .pcs {
    padding-block: var(--band);
  }
  .plist {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--s-6);
    margin-block-start: var(--s-7);
  }
  .plist li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
  }
  .pn {
    font-size: var(--t-micro);
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--emerald);
  }
  .plist h3 {
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: var(--tr-tight);
  }
  .plist p {
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.6;
  }

  @media (max-width: 880px) {
    .prem-in,
    .rgrid {
      grid-template-columns: 1fr;
    }
    .rgrid > :nth-child(even) {
      margin-block-start: 0;
    }
  }
</style>
