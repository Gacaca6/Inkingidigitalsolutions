---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Stories from "../components/home/Stories.astro";
import Cta from "../components/Cta.astro";
---

<Base
  title="Our Clients"
  description="Client stories from Inkingi Digital Solutions — retail, healthcare, and agriculture in Rwanda. Challenge, solution, and the measured outcome."
>
  <PageHead
    idx="01"
    label="Our Clients"
    title='Judged on what <span class="accent">changed</span>.'
    lede="Not a gallery of screenshots. Each client is shown the same way — where the business was before, what we built, and the numbers a year later."
  />

  <!-- How we report -->
  <section class="how">
    <div class="page how-in">
      {
        [
          {
            k: "Measured before",
            v: "We note the baseline during our first conversation — orders, enquiries, bookings, hours spent — from the client's own records.",
          },
          {
            k: "Measured after",
            v: "The same numbers, months after launch. Not a survey, not a paid testimonial — the same figures, honestly compared.",
          },
          {
            k: "Named on request",
            v: "Clients here are shown by sector at their own request. Ask us in a strategy session and we'll gladly make an introduction.",
          },
        ].map((x, i) => (
          <div class="hcell" data-reveal style={`--rd:${i * 70}ms`}>
            <p class="hk">{x.k}</p>
            <p class="hv">{x.v}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Stories />
  <Cta
    eyebrow="Your turn"
    title="Let's write the next one together."
    body="Bring the problem that keeps coming back. We'll tell you whether a website, better hosting, a brand, or marketing is the real answer — honestly."
  />
</Base>

<style>
  .how {
    padding-block: var(--band-tight) 0;
  }
  .how-in {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .hcell {
    padding-block-start: var(--s-4);
    border-block-start: 2px solid var(--emerald);
  }
  .hk {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ink);
  }
  .hv {
    margin-block-start: 0.6rem;
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.65;
    max-inline-size: 36ch;
  }
  @media (max-width: 800px) {
    .how-in {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }
</style>
