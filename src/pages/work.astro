---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Cta from "../components/Cta.astro";
import Arrow from "../components/Arrow.astro";
import { portfolio } from "../data/site";

// Astro optimises these at build (resize + webp). id matches filename.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/work/*.png",
  { eager: true }
);
const shotFor = (id: string) => shots[`../assets/work/${id}.png`]?.default;
const domain = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const [feature, ...rest] = portfolio;
const featShot = shotFor(feature.id);
---

<Base
  title="Our Work"
  description="Real, live projects built by Inkingi Digital Solutions — Savanna, Ongera Ubeho, Learn4Africa, AkaziConnect, HanoBus, Kina Wige, and MusiMe. Every one a working link."
>
  <PageHead
    idx="01"
    label="Our Work"
    title='Real products. <span class="accent">Live links.</span>'
    lede="We're a young studio — but not an empty one. Everything below was designed and built by us, and every one is a working link. Don't take our word for it; click through."
  />

  <section class="gallery">
    <div class="page">
      <!-- Featured project -->
      <article class="feat" data-reveal>
        <a
          href={feature.live}
          class="shot feat-shot"
          target="_blank"
          rel="noopener"
          aria-label={`Visit ${feature.name}`}
        >
          <span class="chrome">
            <i></i><i></i><i></i>
            <em>{domain(feature.live)}</em>
          </span>
          {featShot && (
            <Image
              src={featShot}
              alt={`${feature.name} — screenshot`}
              widths={[480, 960, 1440]}
              sizes="(max-width: 900px) 100vw, 58vw"
              loading="eager"
            />
          )}
          <span class="visit-badge">Visit live<Arrow /></span>
        </a>

        <div class="feat-info">
          <p class="f-kind">{feature.kind} · {feature.year}</p>
          <h2 class="d2">{feature.name}</h2>
          <p class="body">{feature.blurb}</p>
          <ul class="tags">
            {feature.tags.map((t) => <li>{t}</li>)}
          </ul>
          <a href={feature.live} class="tlink" target="_blank" rel="noopener">
            Open {domain(feature.live)}<Arrow />
          </a>
        </div>
      </article>

      <!-- Grid of the rest -->
      <div class="grid">
        {
          rest.map((p, i) => {
            const shot = shotFor(p.id);
            return (
              <a
                href={p.live}
                class="tile"
                target="_blank"
                rel="noopener"
                data-reveal
                style={`--rd:${i * 70}ms`}
              >
                <span class="shot">
                  <span class="chrome">
                    <i></i><i></i><i></i>
                    <em>{domain(p.live)}</em>
                  </span>
                  {shot && (
                    <Image
                      src={shot}
                      alt={`${p.name} — screenshot`}
                      widths={[360, 720]}
                      sizes="(max-width: 640px) 100vw, 30vw"
                      loading="lazy"
                    />
                  )}
                  <span class="visit-badge">Visit live<Arrow /></span>
                </span>
                <div class="tile-info">
                  <div class="ti-top">
                    <h3>{p.name}</h3>
                    <span class="ti-kind">{p.kind}</span>
                  </div>
                  <p class="ti-blurb">{p.blurb}</p>
                  <div class="ti-tags">
                    {p.tags.map((t) => <span>{t}</span>)}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>

      <p class="note xs" data-reveal>
        A growing portfolio — we add each new project here as it ships. Built by
        us, no templates, no borrowed case studies.
      </p>
    </div>
  </section>

  <Cta
    eyebrow="Be one of the first"
    title="Let's build something worth showing off."
    body="Early clients get our full attention and our best pricing. Bring us your business — we'll treat it like our own."
  />
</Base>

<style>
  .gallery {
    padding-block: var(--band-tight) var(--band);
  }

  /* shared browser-framed screenshot */
  .shot {
    position: relative;
    display: block;
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--hair), var(--lift-1);
    transition: transform var(--d-slow) var(--e-swift),
      box-shadow var(--d-slow) var(--e-swift);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.55rem 0.8rem;
    border-block-end: 1px solid var(--hair);
    background: color-mix(in srgb, var(--ink) 3%, var(--paper-2));
    position: relative;
    z-index: 2;
  }
  .chrome i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--hair-2);
  }
  .chrome em {
    margin-inline-start: 0.5rem;
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 600;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .shot :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 900ms var(--e-swift);
  }
  .visit-badge {
    position: absolute;
    inset-block-end: 0.9rem;
    inset-inline-end: 0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--r-pill);
    background: var(--emerald);
    color: var(--on-accent);
    font-size: var(--t-xs);
    font-weight: 700;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--d-mid) var(--e-swift),
      transform var(--d-mid) var(--e-swift);
    box-shadow: var(--lift-2);
  }
  .visit-badge :global(svg) {
    inline-size: 11px;
    block-size: 11px;
  }

  /* ---- featured ---- */
  .feat {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-block-end: var(--s-9);
  }
  .feat-shot {
    aspect-ratio: 16 / 10.5;
  }
  .feat-shot:hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--emerald), var(--lift-3);
  }
  .feat-shot:hover :global(img) {
    transform: scale(1.03);
  }
  .feat-shot:hover .visit-badge {
    opacity: 1;
    transform: none;
  }
  .feat-info {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .f-kind {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-4);
  }
  .feat-info .body {
    max-inline-size: 46ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tags li {
    padding: 0.35rem 0.75rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--hair-2);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* ---- grid ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--s-5) var(--s-4);
  }
  .tile {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--s-4);
  }
  .tile .shot {
    aspect-ratio: 16 / 10;
  }
  .tile:hover .shot {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--emerald), var(--lift-2);
  }
  .tile:hover .shot :global(img) {
    transform: scale(1.04);
  }
  .tile:hover .visit-badge {
    opacity: 1;
    transform: none;
  }
  .tile-info {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .ti-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .ti-top h3 {
    font-size: var(--t-d3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
    transition: color var(--d-mid) var(--e-swift);
  }
  .tile:hover .ti-top h3 {
    color: var(--emerald-2);
  }
  .ti-kind {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-4);
    white-space: nowrap;
  }
  .ti-blurb {
    font-size: var(--t-sm);
    color: var(--ink-3);
    line-height: 1.6;
  }
  .ti-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.2rem;
  }
  .ti-tags span {
    font-size: var(--t-micro);
    color: var(--ink-4);
  }

  .note {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
    color: var(--ink-4);
    max-inline-size: 60ch;
  }

  @media (max-width: 900px) {
    .feat {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .feat-info {
      order: 2;
    }
  }
  @media (max-width: 560px) {
    .ti-top {
      flex-direction: column;
      gap: 0.2rem;
    }
    /* touch: show the visit badge without hover */
    .visit-badge {
      opacity: 1;
      transform: none;
    }
  }
</style>
