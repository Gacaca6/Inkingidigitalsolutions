---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Cta from "../components/Cta.astro";
import Arrow from "../components/Arrow.astro";
import { portfolio } from "../data/site";

const [feature, ...rest] = portfolio;
---

<Base
  title="Our Work"
  description="The work of Inkingi Digital Solutions — a new Kigali studio. Starting with this very website, designed, built, and hosted entirely in-house."
>
  <PageHead
    idx="01"
    label="Our Work"
    title='Our name on <span class="accent">every pixel.</span>'
    lede="We're a young studio, and we'd rather show you one thing we're genuinely proud of than a wall of logos. So start with the site you're on — we made it."
  />

  <!-- Featured project: this very site -->
  <section class="feat">
    <div class="page feat-in">
      <div class="feat-say" data-reveal>
        {feature.self && <span class="live-tag">You're looking at it</span>}
        <p class="f-kind">{feature.kind} · {feature.year}</p>
        <h2 class="d1">{feature.name}</h2>
        <p class="body">{feature.blurb}</p>
        <ul class="f-tags">
          {feature.tags.map((t) => <li>{t}</li>)}
        </ul>
        {
          feature.live && (
            <a href={feature.live} class="btn" target="_blank" rel="noopener">
              Visit the live site
              <span class="well"><Arrow /></span>
            </a>
          )
        }
      </div>

      <!-- a large, self-referential browser frame -->
      <div class="feat-vis" data-reveal="scale" style="--rd:120ms" aria-hidden="true">
        <div class="frame">
          <span class="bar">
            <i></i><i></i><i></i>
            <em>inkingi.rw</em>
          </span>
          <div class="shot">
            <div class="shot-nav">
              <span class="mk">
                <b class="dm n"></b><b class="dm n"></b><b class="dm e"></b>
              </span>
              <span class="nl"></span><span class="nl"></span><span class="nl"></span>
              <span class="np"></span>
            </div>
            <div class="shot-hero">
              <span class="hl"></span>
              <span class="hl short accent-bg"></span>
              <span class="hp"></span>
              <span class="hrow"><span class="hb1"></span><span class="hb2"></span></span>
            </div>
            <div class="shot-cards">
              <span class="sc"></span><span class="sc"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest "more coming" + capability -->
  <section class="more">
    <div class="page">
      <div class="more-grid">
        <div class="more-say" data-reveal>
          <p class="tag"><span class="idx">02</span> Just getting started</p>
          <h2 class="d2">This page grows with every project.</h2>
          <p class="body">
            We're at the beginning of our journey — building openly, and adding
            each real project here as it ships. No stock photos, no borrowed
            case studies, no invented numbers. When we say we built something,
            we'll link you to it.
          </p>
          <a href="/services" class="tlink">See what we can build for you<Arrow /></a>
        </div>

        {
          rest.length === 0 && (
            <div class="slot" data-reveal style="--rd:120ms">
              <span class="slot-mk" aria-hidden="true">
                <b></b><b></b><b></b>
              </span>
              <p class="slot-t">Your project could be next.</p>
              <p class="slot-b">
                A website, a brand, a store — built to the standard you see
                here. Let's talk about yours.
              </p>
              <a href="/contact" class="tlink">Start a project<Arrow /></a>
            </div>
          )
        }
      </div>

      {
        rest.length > 0 && (
          <div class="grid">
            {rest.map((p, i) => (
              <article class="pcard" data-reveal style={`--rd:${i * 70}ms`}>
                <div class="pc-head">
                  <span class="pc-idx num">{String(i + 2).padStart(2, "0")}</span>
                  <span class="pc-kind">{p.kind} · {p.year}</span>
                </div>
                <h3 class="pc-name">{p.name}</h3>
                <p class="pc-blurb">{p.blurb}</p>
                <div class="pc-foot">
                  <div class="pc-tags">
                    {p.tags.slice(0, 3).map((t) => <span>{t}</span>)}
                  </div>
                  {p.live && (
                    <a href={p.live} class="tlink" target="_blank" rel="noopener">
                      Visit<Arrow />
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Cta
    eyebrow="Be one of the first"
    title="Let's build something worth showing off."
    body="Early clients get our full attention and our best pricing. Bring us your business — we'll treat it like our own."
  />
</Base>

<style>
  .feat {
    padding-block: var(--band-tight) var(--band);
  }
  .feat-in {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .feat-say {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .live-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--r-pill);
    background: var(--emerald-wash);
    color: var(--emerald-2);
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .live-tag::before {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--emerald);
  }
  .f-kind {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-4);
  }
  .feat-say h2 {
    max-inline-size: 16ch;
  }
  .feat-say .body {
    max-inline-size: 50ch;
  }
  .f-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .f-tags li {
    padding: 0.35rem 0.75rem;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--hair-2);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-2);
  }

  /* browser frame */
  .frame {
    border-radius: var(--r-4);
    background: var(--paper-2);
    box-shadow: inset 0 0 0 1px var(--hair), var(--lift-3);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.7rem 0.9rem;
    border-block-end: 1px solid var(--hair);
    background: color-mix(in srgb, var(--ink) 2.5%, var(--paper-2));
  }
  .bar i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--hair-2);
  }
  .bar em {
    margin-inline-start: 0.6rem;
    padding: 0.2rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 600;
    color: var(--ink-3);
  }
  .shot {
    padding: 1.1rem 1.3rem 1.6rem;
    display: grid;
    gap: 1rem;
  }
  .shot-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mk {
    position: relative;
    inline-size: 22px;
    block-size: 18px;
    flex: none;
  }
  .dm {
    position: absolute;
    inline-size: 9px;
    block-size: 9px;
    border-radius: 2.5px;
    rotate: 45deg;
  }
  .dm.n {
    background: var(--ink);
  }
  .dm.e {
    background: var(--emerald);
  }
  .mk .dm:nth-child(1) {
    inset-inline-start: 7px;
    inset-block-start: 0;
  }
  .mk .dm:nth-child(2) {
    inset-inline-start: 0;
    inset-block-start: 8px;
  }
  .mk .dm:nth-child(3) {
    inset-inline-start: 11px;
    inset-block-start: 9px;
  }
  .nl {
    inline-size: 26px;
    block-size: 5px;
    border-radius: 2px;
    background: var(--hair-2);
  }
  .np {
    margin-inline-start: auto;
    inline-size: 44px;
    block-size: 16px;
    border-radius: var(--r-pill);
    background: var(--emerald);
  }
  .shot-hero {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.2rem;
  }
  .hl {
    inline-size: 68%;
    block-size: 17px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .hl.short {
    inline-size: 40%;
  }
  .accent-bg {
    background: var(--emerald) !important;
  }
  .hp {
    inline-size: 56%;
    block-size: 6px;
    border-radius: 3px;
    background: var(--hair-2);
    margin-block-start: 0.2rem;
  }
  .hrow {
    display: flex;
    gap: 8px;
    margin-block-start: 0.5rem;
  }
  .hb1,
  .hb2 {
    block-size: 22px;
    border-radius: var(--r-pill);
  }
  .hb1 {
    inline-size: 88px;
    background: var(--ink);
  }
  .hb2 {
    inline-size: 68px;
    box-shadow: inset 0 0 0 1px var(--hair-2);
  }
  .shot-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .sc {
    block-size: 46px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--hair);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
  }

  /* more section */
  .more {
    padding-block: var(--band);
  }
  .more-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .more-say {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .more-say h2 {
    max-inline-size: 16ch;
  }
  .more-say .body {
    max-inline-size: 50ch;
  }
  .slot {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    padding: var(--s-7) var(--s-6);
    border-radius: var(--r-4);
    box-shadow: inset 0 0 0 1.5px var(--hair);
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 12px,
      color-mix(in srgb, var(--ink) 2%, transparent) 12px,
      color-mix(in srgb, var(--ink) 2%, transparent) 13px
    );
  }
  .slot-mk {
    display: flex;
    gap: 5px;
  }
  .slot-mk b {
    inline-size: 14px;
    block-size: 14px;
    border-radius: 4px;
    rotate: 45deg;
    background: var(--hair-2);
  }
  .slot-mk b:last-child {
    background: var(--emerald);
  }
  .slot-t {
    font-size: var(--t-d3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
  }
  .slot-b {
    font-size: var(--t-sm);
    color: var(--ink-3);
    max-inline-size: 34ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--s-4);
    margin-block-start: var(--s-8);
  }
  .pcard {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-6);
    border-radius: var(--r-3);
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: transform var(--d-mid) var(--e-swift),
      box-shadow var(--d-mid) var(--e-swift);
  }
  .pcard:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px var(--emerald);
  }
  .pc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .pc-idx {
    font-size: var(--t-micro);
    font-weight: 700;
    color: var(--emerald-2);
  }
  .pc-kind {
    font-size: var(--t-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-4);
  }
  .pc-name {
    font-size: var(--t-d3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
  }
  .pc-blurb {
    font-size: var(--t-sm);
    color: var(--ink-3);
    line-height: 1.6;
  }
  .pc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-block-start: var(--s-2);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--hair);
  }
  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pc-tags span {
    font-size: var(--t-micro);
    color: var(--ink-4);
  }

  @media (max-width: 900px) {
    .feat-in,
    .more-grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }
</style>
