---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Cta from "../components/Cta.astro";
import PackageCards from "../components/PackageCards.astro";
import ServiceTiers from "../components/ServiceTiers.astro";
import { services } from "../data/site";

// the three services that carry their own tier pricing
const tiered = services.filter((s) => s.pricing !== "packages");

const faqs = [
  {
    q: "Why publish prices at all?",
    a: "Because the alternative wastes your time and ours. If our starting point is beyond your budget this quarter, you should know that from a web page — not after three meetings.",
  },
  {
    q: "What does the monthly website fee actually cover?",
    a: "Hosting, your SSL certificate, security updates, daily backups, small content changes, and priority support when something needs a human. It is care, not a payment plan for the build.",
  },
  {
    q: "Can I pay the setup fee in instalments?",
    a: "Yes. Website builds run 40% to begin, 40% at design sign-off, and 20% on launch. We agree the schedule before any work starts.",
  },
  {
    q: "Do the prices include VAT?",
    a: "No — all prices shown exclude VAT. Your quote after the strategy session will show the VAT-inclusive total clearly.",
  },
  {
    q: "Is the strategy session really free?",
    a: "Yes. You leave it with a written brief whether or not you engage us. We would rather be the firm that gave you a useful hour than the one that invoiced for it.",
  },
];
---

<Base
  title="Pricing"
  description="Transparent pricing in Rwandan francs for website design, web hosting, graphic design, and digital marketing. Real starting prices, no hidden costs."
>
  <PageHead
    idx="01"
    label="Pricing"
    title='What it costs, <span class="accent">before</span> you ask.'
    lede="Most firms in this market will not publish a number. We will. These are real starting points — the free strategy session turns one into a fixed quote."
  />

  <!-- Website packages -->
  <section class="web">
    <div class="page">
      <div class="sec-head" data-reveal>
        <h2 class="d2">Website design packages</h2>
        <p class="sm">Setup fee builds it. The small monthly keeps it fast, secure, and looked after.</p>
      </div>
      <div class="sec-body">
        <PackageCards />
      </div>
    </div>
  </section>

  <!-- Other services -->
  {
    tiered.map((s, i) => (
      <section class:list={["svc", { alt: i % 2 === 0 }]}>
        <div class="page">
          <div class="sec-head" data-reveal>
            <p class="tag"><span class="idx">{s.idx}</span> {s.name}</p>
            <h2 class="d2">{s.tagline}</h2>
          </div>
          <div class="sec-body">
            {s.pricing !== "packages" && (
              <ServiceTiers lede={s.pricing.lede} tiers={s.pricing.tiers} />
            )}
          </div>
        </div>
      </section>
    ))
  }

  <!-- FAQ -->
  <section class="faq on-navy">
    <div class="page">
      <p class="tag" data-reveal><span class="idx">?</span> Straight answers</p>
      <h2 class="d1" data-reveal style="--rd:60ms">No small print.</h2>
      <div class="qa">
        {
          faqs.map((x, i) => (
            <details class="q" data-reveal style={`--rd:${i * 50}ms`}>
              <summary>
                <span>{x.q}</span>
                <i aria-hidden="true" />
              </summary>
              <p>{x.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    eyebrow="No obligation"
    title="Get a fixed quote for your project."
    body="Bring us the problem, not a specification. We'll tell you what it takes, what it costs, and what you shouldn't pay for."
  />
</Base>

<style>
  .web {
    padding-block: var(--band-tight) var(--band);
  }
  .svc {
    padding-block: var(--band);
  }
  .svc.alt {
    background: var(--paper-2);
    border-block: 1px solid var(--hair);
  }
  .sec-head {
    display: grid;
    gap: var(--s-3);
    margin-block-end: var(--s-7);
  }
  .sec-head .tag {
    margin-block-end: 0.2rem;
  }

  /* FAQ */
  .faq {
    padding-block: var(--band);
  }
  .faq h2 {
    margin-block-start: var(--s-4);
  }
  .qa {
    margin-block-start: var(--s-6);
    max-inline-size: 62rem;
  }
  .q {
    border-block-start: 1px solid var(--hair);
  }
  .q:last-of-type {
    border-block-end: 1px solid var(--hair);
  }
  .q summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
    font-size: var(--t-d3);
    font-weight: 700;
    letter-spacing: var(--tr-tight);
    transition: color var(--d-mid) var(--e-swift);
  }
  .q summary::-webkit-details-marker {
    display: none;
  }
  .q summary:hover {
    color: var(--emerald-2);
  }
  .q summary i {
    position: relative;
    inline-size: 13px;
    block-size: 13px;
    flex: none;
  }
  .q summary i::before,
  .q summary i::after {
    content: "";
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 13px;
    block-size: 1.6px;
    background: currentColor;
    transition: transform var(--d-mid) var(--e-swift);
  }
  .q summary i::after {
    rotate: 90deg;
  }
  .q[open] summary i::after {
    transform: scaleX(0);
  }
  .q p {
    padding-block-end: var(--s-5);
    color: var(--ink-2);
    max-inline-size: 68ch;
    animation: qIn 0.45s var(--e-out);
  }
  @keyframes qIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 600px) {
    .q summary {
      font-size: 1.1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .q p {
      animation: none;
    }
  }
</style>
